# Скопируйте в .env и заполните. Файл .env не коммитится (см. .gitignore).

# --- Вариант 1: GigaChat (основной провайдер команды) ---
# AI_PROVIDER=gigachat
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Если access token уже получен, можно задать его напрямую (живёт ~30 минут):
# GIGACHAT_ACCESS_TOKEN=
# Для корпоративного контура при необходимости замените адреса:
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
# GIGACHAT_CA_BUNDLE=/path/to/trusted-ca.pem

# --- Вариант 2: локальная модель без аккаунта (для жюри) ---
# 1) Установить Ollama: https://ollama.com
# 2) ollama pull qwen2.5:3b
# 3) AI_PROVIDER=ollama OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# Для локального сервера llama.cpp:
# AI_PROVIDER=llamacpp
# LLAMACPP_URL=http://127.0.0.1:18080
# LLAMACPP_MODEL=qwen2.5-3b-instruct

# --- Общие настройки ---
# VACANCY_SOURCE_URL=https://opendata.trudvsem.ru/api/v1/vacancies/region/39
# VACANCY_SCHEDULE=0 9 * * *
# VACANCY_MAX=50
